# --- Google Apps Script (后端 API) ---
# 部署 GAS 后的网路应用程式 URL (必填)
# 格式应为 https://script.google.com/macros/s/XXX/exec
VITE_GAS_API_URL=your_google_apps_script_url_here

# --- 专案通用配置 (可选) ---
# 预设货币符号，例如: TWD, USD
VITE_DEFAULT_CURRENCY=TWD

# 资料缓存失效时间 (单位: 秒)，预设 3600 (1小时)
VITE_CACHE_TTL=3600

# --- 开发环境调试 ---
# 是否开启侦错模式 (true/false)
VITE_ENABLE_DEBUG=false